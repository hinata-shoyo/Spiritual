# Copy this file to backend/.env and fill in your values.
# All variables are optional. The site runs without them, but the photo
# gallery (Cloudinary) and video feeds (YouTube) need them.

# Photo gallery (Cloudinary): https://cloudinary.com
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Video feeds (YouTube Data API): https://console.cloud.google.com
YOUTUBE_API_KEY=

# Server port (defaults to 3000 if unset)
PORT=3000